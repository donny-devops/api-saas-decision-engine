# Copy to .env (never commit it). In production prefer the `file` or `vault`
# secrets providers — see docs/security.md.
NODE_ENV=development
PORT=8787
HOST=127.0.0.1
PUBLIC_URL=http://localhost:8787
DATABASE_PATH=data/decision-engine.db
LOG_REQUESTS=true
CORS_ORIGINS=

# Secrets manager: provider order (file, env, vault)
SECRETS_PROVIDERS=file,env
SECRETS_DIR=/run/secrets
# VAULT_ADDR=https://vault.example.com
# VAULT_TOKEN=
# VAULT_MOUNT=secret
# VAULT_PATH=decision-engine

# --- Secrets (resolved through the secrets manager) ---
# 32 random bytes, base64:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DATA_ENCRYPTION_KEY=
ADMIN_API_KEY=
INBOUND_EMAIL_TOKEN=
INBOUND_EMAIL_ALLOWLIST=@yourcompany.com
GITHUB_WEBHOOK_SECRET=
SLACK_WEBHOOK_URL=
RESEND_API_KEY=
MAIL_FROM=Decision Engine <engine@yourcompany.com>

# Features
SCHEDULER_ENABLED=false
A2A_REQUIRE_PAYMENT=false
ALLOW_PRIVATE_WEBHOOKS=false
