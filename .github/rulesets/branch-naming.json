{
  "name": "branch-naming",
  "target": "branch",
  "enforcement": "active",
  "conditions": { "ref_name": { "include": ["~ALL"], "exclude": ["~DEFAULT_BRANCH", "refs/heads/dependabot/**"] } },
  "bypass_actors": [],
  "rules": [
    {
      "type": "branch_name_pattern",
      "parameters": {
        "name": "conventional prefix",
        "operator": "regex",
        "pattern": "^(feat|fix|chore|docs|refactor|test|perf|ci)/[a-z0-9._-]+$",
        "negate": false
      }
    }
  ]
}
